# Copy to .env and replace every "change-me" value. scripts/init-env.sh does this for you, and on
# later runs adds any keys that are missing from an existing .env.
# Never commit .env.

# production | development (development enables the /scalar API reference and pretty logs)
NODE_ENV=production
LOG_LEVEL=info

# MongoDB
MONGO_ROOT_USERNAME=parley
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=parley

# Redis
REDIS_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USERNAME=parley
RABBITMQ_PASSWORD=change-me

# coturn (TURN/STUN). TURN_EXTERNAL_IP must be the address browsers can reach.
TURN_SECRET=change-me
TURN_REALM=parley.local
TURN_EXTERNAL_IP=127.0.0.1
# ICE servers handed to browsers (comma-separated). Use the public host name in production.
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
STUN_URLS=stun:localhost:3478

# Frontend origin allowed by CORS and used to build links in emails
FRONTEND_ORIGIN=http://localhost:3000

# Identity. Secrets must be at least 32 characters; *_KEY values are 32 random bytes in base64.
JWT_SECRET=change-me
HASH_SECRET=change-me
TOTP_ENCRYPTION_KEY=change-me
# Current Terms and Community Guidelines version; changing it asks everyone to accept again.
TERMS_VERSION=2026-10-25
# Refresh cookie Secure flag. Browsers accept Secure cookies on http://localhost, so keep true.
COOKIE_SECURE=true
# Scales every rate limit. Keep 1 in production; local stacks use a higher value so repeated
# end-to-end test runs from one IP are not throttled.
RATE_LIMIT_MULTIPLIER=50

# Email (workers). Mailpit locally.
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Parley <no-reply@parley.local>

# Report evidence retention in days (minor-safety evidence: at least 365).
EVIDENCE_RETENTION_DAYS=30
MINOR_SAFETY_RETENTION_DAYS=365

# Seeded SuperAdmin (see scripts/seed.sh). The password is generated and printed once.
SEED_ADMIN_EMAIL=admin@parley.local

# Optional OpenTelemetry collector (OTLP). Leave empty to disable export.
OTEL_EXPORTER_OTLP_ENDPOINT=
