{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "Database": "parley"
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/",
    "PrefetchCount": 16,
    "DeliveryLimit": 5
  }
}
