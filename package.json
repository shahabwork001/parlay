{
  "name": "parley-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "tsx watch --env-file-if-exists=.env.local src/api/server.ts",
    "dev:workers": "tsx watch --env-file-if-exists=.env.local src/workers/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node --import ./dist/infrastructure/observability/instrumentation.js dist/api/server.js",
    "start:workers": "node --import ./dist/infrastructure/observability/instrumentation.js dist/workers/main.js",
    "lint": "eslint --max-warnings=0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-amqplib": "^0.71.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-mongodb": "^0.77.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@scalar/express-api-reference": "^0.10.31",
    "amqplib": "^2.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.5.2",
    "ioredis": "^6.0.0",
    "mongodb": "^7.7.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testcontainers/mongodb": "^12.2.1",
    "@testcontainers/rabbitmq": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
