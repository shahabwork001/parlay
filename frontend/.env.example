# Public base URL of the Parley API, as reached from the browser.
# Inlined at build time (NEXT_PUBLIC_*). Rebuild after changing it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Base URL for Playwright E2E runs against an already-running stack (optional).
# When unset, Playwright builds and starts the app itself.
E2E_BASE_URL=
